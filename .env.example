APP_URL=http://localhost:8000
DATA_DIR=./data
# Generate at least 32 random characters. Required even for public browsing.
SESSION_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
OWNER_SUBJECT=
MCP_AUDIENCE=http://localhost:8000/mcp
# Comma-separated hostnames, never a wildcard in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CODEX_HOME=./data/codex
# Fine-grained token with Contents read access to the selected private template repositories.
GITHUB_TOKEN=
WORKER_INTERVAL=300

COVER_LETTER_REPO=
COVER_LETTER_BRANCH=main
COVER_LETTER_ENTRY=cover-letter.tex

# Optional read-only collection from a dedicated employer correspondence folder
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FOLDER=Applications

# Public LinkedIn profile results in Referrals
EXA_API_KEY=
